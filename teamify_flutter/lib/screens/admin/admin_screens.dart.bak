class AnalystScreen extends StatelessWidget {
  const AnalystScreen({super.key});
  @override
  Widget build(BuildContext context) {
    return Scaffold(
      backgroundColor: AppColors.background,
      appBar: AppBar(leading: IconButton(icon: const Icon(Icons.arrow_back_ios, size: 18), onPressed: () => Navigator.pop(context)), title: const Text('Analytics', style: TextStyle(fontWeight: FontWeight.bold))),
      body: ListView(padding: const EdgeInsets.all(16), children: [
        Row(children: [
          StatBox(value: '24', label: 'Total Users', icon: Icons.people_outline, iconBg: AppColors.primary),
          const SizedBox(width: 12),
          StatBox(value: '3', label: 'Projects', icon: Icons.folder_outlined, iconBg: AppColors.accent),
        ]),
        const SizedBox(height: 12),
        Row(children: [
          StatBox(value: '98%', label: 'Uptime', icon: Icons.health_and_safety_outlined, iconBg: AppColors.success),
          const SizedBox(width: 12),
          StatBox(value: '2', label: 'Alerts', icon: Icons.warning_amber_outlined, iconBg: AppColors.error),
        ]),
        const SizedBox(height: 16),
        TCard(child: Column(crossAxisAlignment: CrossAxisAlignment.start, children: [
          const Text('User Growth', style: TextStyle(fontWeight: FontWeight.bold, color: AppColors.textPrimary, fontSize: 15)),
          const SizedBox(height: 16),
          SizedBox(height: 100, child: CustomPaint(painter: _GrowthPainter(), child: const SizedBox.expand())),
        ])),
        const SizedBox(height: 12),
        TCard(child: Column(crossAxisAlignment: CrossAxisAlignment.start, children: [
          const Text('Activity by Role', style: TextStyle(fontWeight: FontWeight.bold, color: AppColors.textPrimary, fontSize: 15)),
          const SizedBox(height: 12),
          ...[('Admin', 1, 0.04), ('Freelancers', 2, 0.08), ('Students', 2, 0.08)].map((r) => Padding(padding: const EdgeInsets.only(bottom: 10), child: Row(children: [
            SizedBox(width: 90, child: Text(r.$1, style: const TextStyle(fontSize: 13, color: AppColors.textSecondary))),
            Expanded(child: TBar(value: r.$3 * 12)),
            const SizedBox(width: 8),
            Text('${r.$2}', style: const TextStyle(fontWeight: FontWeight.bold, color: AppColors.textPrimary)),
          ]))),
        ])),
      ]),
    );
  }
}

class _GrowthPainter extends CustomPainter {
  @override
  void paint(Canvas canvas, Size size) {
    final months = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun'];
    final vals = [10.0, 14.0, 16.0, 18.0, 22.0, 24.0];
    final pts = List.generate(vals.length, (i) => Offset(i * size.width / (vals.length - 1), size.height * 0.85 - (vals[i] / 24) * size.height * 0.75));
    final paint = Paint()..color = AppColors.primary..strokeWidth = 2.5..style = PaintingStyle.stroke;
    final path = Path()..moveTo(pts[0].dx, pts[0].dy);
    for (final p in pts.skip(1)) path.lineTo(p.dx, p.dy);
    canvas.drawPath(path, paint);
    for (final p in pts) canvas.drawCircle(p, 4, Paint()..color = AppColors.primary);
    final tp = TextPainter(textDirection: TextDirection.ltr);
    for (int i = 0; i < months.length; i++) {
      tp.text = TextSpan(text: months[i], style: const TextStyle(fontSize: 10, color: AppColors.textSecondary));
      tp.layout();
      tp.paint(canvas, Offset(pts[i].dx - tp.width / 2, size.height - 14));
    }
  }
  @override
  bool shouldRepaint(covariant CustomPainter o) => false;
}

